# 顶级 EditorConfig 文件
root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

# C / C++ 源码
[*.{c,h,cpp,hpp}]
indent_size = 4
# 显式 UTF-8（源码里有中文宽字符串字面量，靠编译器的 /utf-8 生效）
charset = utf-8

# 批处理脚本必须纯 ASCII —— cmd.exe 按 OEM 码页解析 .bat，
# UTF-8 中文会把命令行切碎。
[*.bat]
charset = latin1
end_of_line = crlf
insert_final_newline = true

# 构建脚本与工程文件
[*.{cmake,txt}]
insert_final_newline = true

[CMakeLists.txt]
indent_size = 4

# 文档
[*.md]
trim_trailing_whitespace = false
